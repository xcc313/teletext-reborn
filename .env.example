# Copy to .env (gitignored) to configure Teletext Reborn. Every setting is optional:
# with no .env at all the app runs fully on keyless Open-Meteo weather (London)
# and the bundled demo news feed. Restart `npm run dev` after changing values.

# GNews API key (https://gnews.io) for live headlines on page 101.
# Leave empty to use the bundled demo feed (public/demo-news.json).
# Note: Vite embeds VITE_* values in the browser bundle, so use a free-tier,
# revocable key and never commit a real one.
VITE_NEWS_API_KEY=

# Weather location for page 302. Set BOTH coordinates, or neither.
# When unset, invalid or out of range, the default location (London, UK:
# 51.5072, -0.1276) is used.
VITE_WEATHER_LATITUDE=
VITE_WEATHER_LONGITUDE=
# Name shown in the page 302 heading (up to 24 characters). Defaults to the coordinates.
VITE_WEATHER_NAME=
